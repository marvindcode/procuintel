<h1><%= @part.name %></h1>
<p>
  <% if current_user&.role == "admin" %>
    <%= link_to "Add Inventory", new_part_inventory_path(@part), class: "btn" %>
    <%= link_to "Edit Part", edit_part_path(@part), class: "btn secondary" %>
  <% end %>
  <%= link_to "Back to Parts", parts_path, class: "btn secondary" %>
</p>

<h2>Inventories</h2>
<% @part.inventories.each do |inventory| %>
  <div>
    <p>Warehouse: <%= inventory.warehouse.name %> | Qty: <%= inventory.quantity %> | Safe: <%= inventory.safe_inventory %></p>
    <% @part.demand_forecasts.each do |forecast| %>
      <% if needs_reorder?(inventory, forecast) %>
        <span class="alert">Reorder needed for <%= forecast.period %>!</span>
      <% end %>
    <% end %>
  </div>
<% end %>