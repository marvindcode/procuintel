<div class="card">
  <%= form_with model: @part do |f| %>
    <div class="grid">
      <div>
        <%= f.label :part_number %>
        <%= f.text_field :part_number %>
      </div>
      <div>
        <%= f.label :name %>
        <%= f.text_field :name %>
      </div>
      <div>
        <%= f.label :category %>
        <%= f.text_field :category %>
      </div>
      <div>
        <%= f.label :lead_time, "Lead time (days)" %>
        <%= f.number_field :lead_time %>
      </div>
      <div>
        <%= f.label :price %>
        <%= f.number_field :price, step: 0.01 %>
      </div>
      <div>
        <%= f.label :uom_id, "UOM" %>
        <%= f.collection_select :uom_id, Uom.order(:code), :id, :code, include_blank: true %>
      </div>
      <div style="grid-column:1 / -1">
        <%= f.label :description %>
        <%= f.text_area :description, rows: 3 %>
      </div>
      <div>
        <%= f.label :is_active %>
        <%= f.check_box :is_active %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit class: "btn" %>
      <%= link_to "Cancel", parts_path, class: "btn secondary" %>
    </div>
  <% end %>
</div>

<style>
  .grid { display:grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap:12px; }
</style>
