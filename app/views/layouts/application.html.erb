<!DOCTYPE html>
<html>
<head>
  <title>Procuintel</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header class="site-header">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;">
      <div style="font-weight:600">Procuintel</div>
      <nav>
        <%= link_to "Dashboard", dashboard_path, class: "btn secondary" %>
        <%= link_to "Parts", parts_path, class: "btn secondary" %>
        <%= link_to "Inventories", inventories_path, class: "btn secondary" %>
        <%= link_to "Warehouses", warehouses_path, class: "btn secondary" %>
        <% if user_signed_in? %>
          <span style="margin:0 8px">Signed in as <%= current_user.email %></span>
          <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn secondary", form: { style: "display:inline" } %>
        <% else %>
          <%= link_to "Login", new_user_session_path, class: "btn" %>
        <% end %>
      </nav>
    </div>
  </header>

  <div class="container">
    <% if notice %><div class="flash notice"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert"><%= alert %></div><% end %>

    <!-- THIS renders each page (Devise forms, dashboard, parts, etc.) -->
    <%= yield %>
  </div>

  <footer class="footer">© <%= Time.current.year %> Procuintel. All rights reserved.</footer>
</body>
</html>

